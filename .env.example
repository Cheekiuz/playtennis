# Vercel Supabase integration sets these automatically in production.
# For local dev, run: npx vercel env pull .env.local
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# Legacy names also supported:
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public site URL for SEO (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.playtennis.lt
