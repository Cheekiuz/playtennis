# Vercel Supabase integration sets these automatically in production.
# For local dev, run: npx vercel env pull .env.local
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-key-here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Legacy names also supported:
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Court monitoring cron (Vercel Hobby has no cron — use GitHub Actions workflow monitor-courts.yml)
# GitHub repo secrets: CRON_SECRET (required), SITE_URL (optional, default https://www.playtennis.lt)
CRON_SECRET=generate-a-random-secret

# Email notifications via Resend (https://resend.com)
RESEND_API_KEY=re_your_key_here
ALERT_EMAIL_FROM=PlayTennis.lt <alerts@playtennis.lt>
# Optional — recipient for: node scripts/send-test-court-alert-email.mjs
# TEST_ALERT_EMAIL=you@example.com

# SEB Arena court availability provider:
#   mock   — deterministic demo data (local dev default)
#   scrape — live data from ws.tenisopasaulis.lt (no login required for reads)
#   seb    — future official partner API
SEB_ARENA_PROVIDER=mock
SEB_ARENA_SALE_POINT=11
# Optional — only needed for user-specific slot visibility
# SEB_ARENA_BOOKING_USERNAME=
# SEB_ARENA_BOOKING_PASSWORD=
SEB_ARENA_API_BASE_URL=https://partner-api.example.com/v1
SEB_ARENA_API_TOKEN=your-partner-token

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public site URL for SEO (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.playtennis.lt
